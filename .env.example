# Copy to .env and fill in. NEVER commit .env.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional overrides (defaults shown; all served via OpenRouter)
# GENERATOR_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# GENERATOR_PROVIDER=coreweave            # pinned so all runs hit one bf16 deployment
# JUDGE_MODEL=openai/gpt-4o-mini          # fixed judge, cross-vendor from the generator
# EMBEDDING_MODEL=baai/bge-m3
# RERANK_MODEL=cohere/rerank-v3.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Postgres + pgvector (podman container; see README)
# PG_DSN=postgresql://rag:rag@127.0.0.1:5434/ragtb
